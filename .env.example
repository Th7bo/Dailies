# Postgres connection string
DATABASE_URL=postgres://dailies:dailies@localhost:5432/dailies

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=https://daily.th7bo.dev
AUTH_TRUST_HOST=true

# Discord OAuth app (https://discord.com/developers/applications)
# Redirect URL: https://daily.th7bo.dev/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Comma-separated Discord user IDs allowed to manage the shared catalog
ADMIN_DISCORD_IDS=

# docker-compose only: password for the bundled Postgres
POSTGRES_PASSWORD=
